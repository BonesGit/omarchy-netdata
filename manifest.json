{
  "schemaVersion": 1,
  "id": "io.github.bonesgit.omarchy-netdata",
  "name": "Netdata Monitor",
  "version": "1.4.0",
  "author": "bonesgit",
  "license": "MIT",
  "description": "Netdata GPU utilization and temperature monitor for the Omarchy bar, with history popup.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Netdata",
    "description": "Status pill for a remote Netdata host, with GPU utilization history.",
    "category": "System",
    "allowMultiple": true,
    "defaultSection": "right",
    "defaults": {
      "host": "localhost",
      "refreshSeconds": 5,
      "retryAttempts": 5,
      "gpu": "nvidia",
      "context": "",
      "tempContext": "",
      "dashboardUrl": ""
    },
    "schema": [
      {
        "key": "host",
        "type": "string",
        "label": "Netdata host",
        "defaultValue": "localhost"
      },
      {
        "key": "refreshSeconds",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 2,
        "max": 60,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "retryAttempts",
        "type": "integer",
        "label": "Failed polls before pause",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "gpu",
        "type": "enum",
        "label": "GPU",
        "options": ["nvidia", "amd"],
        "defaultValue": "nvidia",
        "description": "Picks the Netdata utilization and temperature charts. Blank is the same as nvidia. context and tempContext override those picks."
      },
      {
        "key": "context",
        "type": "string",
        "label": "Netdata context override",
        "defaultValue": ""
      },
      {
        "key": "tempContext",
        "type": "string",
        "label": "GPU temp context override",
        "defaultValue": ""
      },
      {
        "key": "dashboardUrl",
        "type": "string",
        "label": "Dashboard URL (blank = host)",
        "defaultValue": ""
      }
    ]
  }
}
